{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(levelname)s - [%(user_id)s] [%(request_id)s] - %(filename)s:%(lineno)d - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "format": "%(asctime)s - %(levelname)s - [%(user_id)s] [%(request_id)s] - %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "filters": {
    "request_context": {
      "()": "logging_utils.RequestContextFilter"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "filters": ["request_context"]
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "filters": ["request_context"]
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [
        "default"
      ],
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "default"
    ]
  }
}
